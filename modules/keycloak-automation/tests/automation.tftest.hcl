# Offline test (no Keycloak or 1Password needed): the automation client is a confidential service-account client of
# the master realm that can only use the client-credentials grant, it gets `create-realm` and, for realms that already
# exist, `realm-admin` of each realm's management client, and invalid input is rejected.
#
# Both providers are mocked and every run is a `plan`, so nothing here ever connects anywhere: the hostname and the
# item names below are placeholders (example.com is reserved for documentation) and only have to be well-formed.
# Run: tofu test (from this directory)

mock_provider "keycloak" {}

mock_provider "onepassword" {
  mock_data "onepassword_item" {
    defaults = {
      username = "admin"
      password = "mock-secret"
    }
  }
}

variables {
  onepassword          = { service_account_token = "token" }
  onepassword_vault_id = "vault-id"
  keycloak_url         = "https://auth.example.com"
  admin_item_title     = "keycloak-bootstrap-admin#dev"
  client_item_title    = "keycloak-terragrunt#dev"
}

run "client_uses_only_the_client_credentials_grant" {
  command = plan

  assert {
    condition     = keycloak_openid_client.this.realm_id == "master" && keycloak_openid_client.this.client_id == "terragrunt" && keycloak_openid_client.this.access_type == "CONFIDENTIAL"
    error_message = "The client must be a confidential client named terragrunt in the master realm."
  }

  assert {
    condition     = keycloak_openid_client.this.service_accounts_enabled && !keycloak_openid_client.this.standard_flow_enabled && !keycloak_openid_client.this.implicit_flow_enabled && !keycloak_openid_client.this.direct_access_grants_enabled
    error_message = "Only the service account (client credentials) may be enabled: no browser flow, no implicit flow, no password grant."
  }
}

run "client_may_create_realms_and_nothing_else_by_default" {
  command = plan

  assert {
    condition     = keycloak_openid_client_service_account_realm_role.create_realm.role == "create-realm" && keycloak_openid_client_service_account_realm_role.create_realm.realm_id == "master"
    error_message = "The client needs the create-realm role of the master realm."
  }

  assert {
    condition     = length(keycloak_openid_client_service_account_role.realm_admin) == 0
    error_message = "Without existing_realms, no realm-admin role is assigned: realms the client creates are administered through what Keycloak grants the creator."
  }
}

run "existing_realms_get_realm_admin_of_their_management_client" {
  command = plan

  variables {
    existing_realms = ["iseja", "admin"]
  }

  assert {
    condition     = length(keycloak_openid_client_service_account_role.realm_admin) == 2 && alltrue([for r in keycloak_openid_client_service_account_role.realm_admin : r.role == "realm-admin" && r.realm_id == "master"])
    error_message = "Every realm in existing_realms must give the client realm-admin of its <realm>-realm client in the master realm."
  }

  assert {
    condition     = data.keycloak_openid_client.realm_management["iseja"].client_id == "iseja-realm" && data.keycloak_openid_client.realm_management["admin"].client_id == "admin-realm"
    error_message = "The management client of a realm is named <realm>-realm."
  }
}

run "secret_rotation_is_a_variable" {
  command = plan

  variables {
    secret_rotation = "2026-11-01"
  }

  assert {
    condition     = keycloak_openid_client.this.client_secret_regenerate_when_changed["rotation"] == "2026-11-01"
    error_message = "The secret is generated by Keycloak and rotated by changing secret_rotation."
  }
}

run "master_realm_is_rejected" {
  command = plan

  variables {
    existing_realms = ["master"]
  }

  expect_failures = [var.existing_realms]
}
